{
  "name": "@afr/client",
  "version": "0.0.0",
  "description": "Typed API client (generated from OpenAPI)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "test": "vitest run --root . --config ../../vitest.config.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
