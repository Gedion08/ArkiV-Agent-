{
  "name": "@afr/crypto",
  "version": "0.0.0",
  "description": "L4 AES-GCM, HPKE, KEK/DEK, HMAC commitments",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@afr/core": "workspace:*",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "ethers": "6.17.0"
  }
}
