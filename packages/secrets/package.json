{
  "name": "@afr/secrets",
  "version": "0.0.0",
  "description": "Per-org envelope keys for secrets at rest (L8 \u00a78)",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE-APPS.md",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@afr/crypto": "workspace:*",
    "@aws-sdk/client-kms": "3.1161.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
