{
  "name": "@afr/store",
  "version": "0.1.0",
  "description": "L3 EvidenceStore + Arkiv/Postgres/memory implementations",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@afr/core": "workspace:*",
    "@arkiv-network/sdk": "1.0.1",
    "cbor-x": "1.6.8",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
