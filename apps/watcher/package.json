{
  "name": "@afr/watcher",
  "version": "0.0.0",
  "description": "Chain watcher + log auditor",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE-APPS.md",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@afr/core": "workspace:*",
    "@afr/crypto": "workspace:*",
    "@afr/log": "workspace:*",
    "@afr/secrets": "workspace:*",
    "@afr/store": "workspace:*",
    "@afr/verifier": "workspace:*",
    "@aws-sdk/client-kms": "3.1161.0",
    "pg": "8.23.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@afr/recorder": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
