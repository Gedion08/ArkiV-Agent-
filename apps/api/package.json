{
  "name": "@afr/api",
  "version": "0.0.0",
  "description": "Control-plane API + notifier worker",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE-APPS.md",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
