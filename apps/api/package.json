  },
  "dependencies": {
    "@afr/core": "workspace:*",
    "@afr/crypto": "workspace:*",
    "@afr/log": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
