{
  "name": "@afr/cli",
  "version": "0.0.0",
  "description": "fr CLI",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE-APPS.md",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --config ../../vitest.config.ts"
  },
  "bin": {
    "fr": "./dist/cli.js"
  },
  "dependencies": {
    "@afr/core": "workspace:*",
    "@afr/crypto": "workspace:*",
    "@afr/identity": "workspace:*",
    "@afr/recorder": "workspace:*",
    "@afr/store": "workspace:*",
    "@afr/verifier": "workspace:*",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@afr/log": "workspace:*"
  }
}
