{
  "name": "@afr/proxy",
  "version": "0.0.0",
  "description": "fr-proxy MCP proxy",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE-APPS.md",
  "type": "module",
  "exports": {
    ".": {
      "@afr/source": "./src/proxy.ts",
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
