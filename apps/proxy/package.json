  },
  "dependencies": {
    "@afr/core": "workspace:*",
    "@afr/log": "workspace:*",
    "@afr/recorder": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "viem": "2.57.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "bin": {
    "fr-proxy": "./dist/cli.js"
  }
}
